{
  "name": "fit-trainer-server",
  "version": "1.0.0",
  "description": "Express and MongoDB API for the Fit Trainer booking platform",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "seed": "node --env-file=.env scripts/seedServices.js",
    "check:models": "node scripts/checkModels.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.3"
  }
}
