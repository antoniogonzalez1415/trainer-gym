# Copy this file to .env and fill in real values.
# .env is ignored by Git. Never commit real secrets.

# Port the API listens on (hosting platforms set this themselves)
PORT=5000

# development or production
NODE_ENV=development

# Atlas connection string for the fit_trainer_app user (secret)
MONGODB_URI=mongodb+srv://username:password@cluster-host/?appName=Cluster0

# Database name inside the cluster
MONGODB_DB_NAME=fit_trainer

# Frontend address allowed to call the API (comma-separate several)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Signs login tokens (secret, at least 32 random characters)
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=1d

# Opening hours are checked in this time zone
STUDIO_TIMEZONE=America/Chicago

# Goal assistant. Without AI_API_KEY it falls back to keyword matching.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=replace-with-provider-key
