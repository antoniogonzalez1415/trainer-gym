{
  "info": {
    "name": "Fit Trainer API",
    "description": "Capstone API tests. Set baseUrl to http://localhost:5000/api or the deployed API. Run requests top to bottom. No secrets are stored here: authToken is filled by the Register/Login requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "email",
      "value": "postman-user@example.com"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "startsAt",
      "value": "2026-12-01T16:00:00.000Z",
      "description": "Must be a future time, on the hour, 6:00-19:00 America/Chicago (16:00Z = 10:00 Chicago in winter)"
    }
  ],
